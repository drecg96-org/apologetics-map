---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Explore the Apologetics Map." } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Apologetics Map</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>Apologetics Map</a>
      <nav aria-label="Primary">
        <a href={base}>Debate Explorer</a>
        <a href={base + "topics/"}>Topics</a>
        <a href={base + "maps/"}>Maps</a>
        <a href={base + "sources/"}>Sources</a>
        <a class="nav-secondary" href={base + "graph.json"}>Graph JSON</a>
        <a class="nav-secondary" href="https://github.com/drecg96-org/apologetics-map">GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Canonical content is Markdown + YAML. Debate Explorer, Debate Map, and Knowledge Graph are generated from the same source graph.
    </footer>
  </body>
</html>
