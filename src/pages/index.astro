---
import GraphExplorer from "../components/GraphExplorer";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadGraph, toGraphPayload } from "../lib/graph";

const { nodes } = await loadGraph();
const graph = toGraphPayload(nodes);
const base = import.meta.env.BASE_URL;
const topics = nodes.filter((node) => node.type === "topic");
const debateNodes = nodes.filter((node) => node.type !== "source" && node.type !== "topic");
const counts = nodes.reduce<Record<string, number>>((result, node) => {
  result[node.type] = (result[node.type] ?? 0) + 1;
  return result;
}, {});
---

<BaseLayout title="Debate Explorer">
  <section class="hero page-width">
    <p class="eyebrow">Debate Explorer</p>
    <h1>Pick a topic. Follow the line.</h1>
    <p>Start with the main question, choose the response that fits, and keep going.</p>
    <div class="hero-onboarding">
      <span>Need the legend?</span>
      <a href={base + "guide/"}>Get oriented →</a>
    </div>
    <div class="stats" aria-label="Graph statistics">
      <span><strong>{nodes.length}</strong> nodes</span>
      <span><strong>{graph.flowEdges.length}</strong> debate moves</span>
      <span><strong>{graph.edges.length}</strong> semantic edges</span>
      {counts.source && <span><strong>{counts.source}</strong> sources</span>}
    </div>
  </section>

  <section class="map-section primary-explorer-section" id="explore">
    <div class="section-heading page-width">
      <div>
        <p class="eyebrow">Primary view</p>
        <h2>Debate Explorer</h2>
      </div>
      <p>Topic → question → position → reasons and counters. Open any note for the details.</p>
    </div>
    <GraphExplorer
      client:load
      graph={graph}
      basePath={base}
      initialMode="line"
      availableModes={["line"]}
    />
  </section>

  {topics.length > 0 && (
    <section class="page-width topic-strip" id="topics">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Browse by subject</p>
          <h2>Topics</h2>
        </div>
        <a href={base + "topics/"}>Browse all topics →</a>
      </div>
      <div class="topic-grid">
        {topics.map((topic) => {
          const members = nodes.filter((node) => node.id !== topic.id && node.topics.includes(topic.id));
          return (
            <a class="topic-card" href={base + "topic/" + topic.id + "/"}>
              <span class="type-badge type-topic">topic</span>
              <h3>{topic.title}</h3>
              {topic.summary && <p>{topic.summary}</p>}
              <div class="topic-counts">
                <span>{members.filter((node) => node.type !== "source").length} debate nodes</span>
                <span>{members.filter((node) => node.type === "source").length} sources</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="page-width orientation-callout">
    <div>
      <p class="eyebrow">Maps & orientation</p>
      <h2>Step back and inspect the whole structure.</h2>
      <p>
        Use Debate Map for conversational branches or Knowledge Graph for support,
        objections, dependencies, evidence, and other semantic relationships.
      </p>
    </div>
    <a class="orientation-link" href={base + "maps/"}>Open maps →</a>
  </section>

  <section class="page-width node-index">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Reference index</p>
        <h2>Debate nodes</h2>
      </div>
      <a href={base + "sources/"}>Browse sources →</a>
    </div>
    <div class="card-grid">
      {debateNodes.map((node) => (
        <a class="node-card" href={base + "node/" + node.id + "/"}>
          <span class={"type-badge type-" + node.type}>{node.type}</span>
          <h3>{node.title}</h3>
          {node.summary && <p>{node.summary}</p>}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
