---
import GraphExplorer from "../../components/GraphExplorer";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadGraph, toGraphPayload } from "../../lib/graph";

const { nodes } = await loadGraph();
const graph = toGraphPayload(nodes);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Maps">
  <section class="hero page-width hero-compact">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={base}>Debate Explorer</a><span>›</span><span aria-current="page">Maps</span>
    </nav>
    <p class="eyebrow">Orientation & exploration</p>
    <h1>Maps</h1>
    <p>
      Both maps now share the same topic → main question → branch → stage-gate skeleton.
      Debate Map shows conversational moves directly; Knowledge Graph keeps that layout
      while overlaying support, challenge, dependency, evidence, and other semantic relationships.
    </p>
  </section>

  <section class="map-section">
    <div class="section-heading page-width">
      <div>
        <p class="eyebrow">Secondary views</p>
        <h2>Debate Map & Knowledge Graph</h2>
      </div>
      <p>
        The shared layout keeps the big-picture structure consistent across views. For
        following one argument step-by-step, use Debate Explorer.
      </p>
    </div>
    <GraphExplorer
      client:load
      graph={graph}
      basePath={base}
      initialMode="debate"
      availableModes={["debate", "atlas"]}
    />
  </section>
</BaseLayout>
