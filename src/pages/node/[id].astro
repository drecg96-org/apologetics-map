---
import ArgumentMapper from "../../components/ArgumentMapper";
import DebatePosition from "../../components/DebatePosition";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadGraph, toGraphPayload } from "../../lib/graph";
import { lookupScriptureReference } from "../../lib/scripture";

export async function getStaticPaths() {
  const { nodes } = await loadGraph();
  return nodes.map((node) => ({ params: { id: node.id } }));
}

const { id } = Astro.params;
const { nodes, byId } = await loadGraph();
const node = byId.get(id!);

if (!node) {
  throw new Error("Unknown node: " + id);
}

const base = import.meta.env.BASE_URL;
const graph = toGraphPayload(nodes);
const focusedMapUrl = base + "maps/?focus=" + encodeURIComponent(node.id) + "&depth=2" + (node.type === "source" ? "&sources=1" : "");
const feedbackApiEndpoint = (import.meta.env.PUBLIC_NODE_FEEDBACK_ENDPOINT ?? "").trim();
const turnstileSiteKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "").trim();
const directFeedbackEnabled = Boolean(feedbackApiEndpoint && turnstileSiteKey);

const semanticOutgoing = node.relationships.map((relationship) => ({
  ...relationship,
  node: byId.get(relationship.target)!,
}));

const semanticIncoming = nodes.flatMap((candidate) =>
  candidate.relationships
    .filter((relationship) => relationship.target === node.id)
    .map((relationship) => ({
      ...relationship,
      node: candidate,
    })),
);

const previousMoves = graph.flowEdges
  .filter((edge) => edge.target === node.id)
  .sort((a, b) => a.priority - b.priority)
  .map((edge) => ({ ...edge, node: byId.get(edge.source)! }))
  .filter((item) => item.node);

const nextMoves = graph.flowEdges
  .filter((edge) => edge.source === node.id)
  .sort((a, b) => a.priority - b.priority)
  .map((edge) => ({ ...edge, node: byId.get(edge.target)! }))
  .filter((item) => item.node);

const topicNodes = node.topics
  .map((topicId) => byId.get(topicId))
  .filter(Boolean);

const references = node.references
  .map((reference) => ({
    ...reference,
    node: byId.get(reference.source),
  }))
  .filter((item) => item.node?.type === "source");

const evidenceNodes = semanticIncoming
  .filter((item) => item.type === "evidence_for" || item.node.type === "evidence");

const inferenceChallenges = node.argument
  ? nodes.flatMap((candidate) =>
      candidate.inference_challenges
        .filter((challenge) => challenge.argument === node.id)
        .map((challenge) => ({
          inference: challenge.inference,
          note: challenge.note,
          nodeId: candidate.id,
          title: candidate.title,
          summary: candidate.summary,
        })),
    )
  : [];

const argumentMap = node.argument ? {
  form: node.argument.form,
  inferences: node.argument.inferences.map((inference) => ({
    ...inference,
    challenges: inferenceChallenges.filter((challenge) => challenge.inference === inference.id),
  })),
  statements: node.argument.statements.map((statement) => {
    const statementNode = byId.get(statement.node)!;
    const incoming = nodes.flatMap((candidate) =>
      candidate.relationships
        .filter((relationship) => relationship.target === statement.node)
        .map((relationship) => ({ type: relationship.type, node: candidate })),
    );
    return {
      ...statement,
      nodeId: statementNode.id,
      title: statementNode.title,
      summary: statementNode.summary,
      scholarship: statementNode.status?.scholarship,
      sourceCount: statementNode.references.length,
      supportCount: incoming.filter((item) => item.type === "supports" || item.type === "evidence_for").length,
      challengeCount: incoming.filter((item) => item.type === "challenges" || item.type === "contradicts").length,
    };
  }),
} : null;

const scriptureReferences = (await Promise.all(
  node.scripture.map(async (entry) => {
    const lookup = await lookupScriptureReference(entry.reference);
    return lookup ? { ...entry, lookup } : null;
  }),
)).filter(Boolean);

function sourceClass(sourceNode: any) {
  if (!sourceNode) return "Reference";
  if (sourceNode.source?.kind === "primary-source" || sourceNode.source?.kind === "scripture") return "Primary";
  if (["book", "paper", "article"].includes(sourceNode.source?.kind ?? "")) return "Academic";
  if (sourceNode.tags.includes("apologetics")) return "Apologetics";
  return "Reference";
}
---

<BaseLayout title={node.title} description={node.summary}>
  <article class="node-page page-width">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={base}>Debate Explorer</a>
      {topicNodes[0] && (
        <>
          <span>›</span>
          <a href={base + "topic/" + topicNodes[0]!.id + "/"}>{topicNodes[0]!.title}</a>
        </>
      )}
      <span>›</span>
      <span aria-current="page">{node.title}</span>
    </nav>

    <header class="node-header">
      <span class={"type-badge type-" + node.type}>{node.type}</span>
      <h1>{node.title}</h1>
      {node.summary && <p class="lede">{node.summary}</p>}
      <div class="meta-row">
        {node.status?.editorial && <span>Editorial: {node.status.editorial}</span>}
        {node.status?.scholarship && <span>Scholarship: {node.status.scholarship}</span>}
        {node.status?.christian && <span>Christian: {node.status.christian}</span>}
      </div>
      <div class="node-share-actions">
        <button type="button" data-copy-current-link>Copy direct link</button>
        <button type="button" class="node-feedback-trigger" data-open-node-feedback>Respond / ask a question</button>
        <a href={focusedMapUrl}>Open focused map →</a>
      </div>
    </header>

    <div class="node-layout">
      <div>
        {node.type === "source" && node.source && (
          <section class="source-detail">
            <p class="eyebrow">Source details</p>
            <dl>
              {node.source.kind && <><dt>Type</dt><dd>{node.source.kind}</dd></>}
              {node.source.authors && <><dt>Author</dt><dd>{node.source.authors.join(", ")}</dd></>}
              {node.source.year && <><dt>Year</dt><dd>{node.source.year}</dd></>}
              {node.source.publisher && <><dt>Publisher</dt><dd>{node.source.publisher}</dd></>}
            </dl>
            {node.source.url && (
              <a class="external-source" href={node.source.url} target="_blank" rel="noreferrer">
                Open original source ↗
              </a>
            )}
          </section>
        )}

        <div class="prose" set:html={node.html} />

        {argumentMap && (
          <section class="argument-structure-section" aria-labelledby="argument-structure-heading">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Formal argument</p>
                <h2 id="argument-structure-heading">Argument anatomy</h2>
              </div>
              <p>
                Premises and conclusions are reusable claim nodes. Open any proposition to inspect
                its support, objections, sources, and place in the wider debate.
              </p>
            </div>
            <ArgumentMapper
              client:load
              form={argumentMap.form}
              statements={argumentMap.statements}
              inferences={argumentMap.inferences}
              basePath={base}
            />
          </section>
        )}

        {(previousMoves.length > 0 || nextMoves.length > 0) && (
          <section class="move-strip" aria-label="Debate navigation">
            {previousMoves.length > 0 && (
              <div>
                <p class="eyebrow">Earlier move</p>
                <div class="move-cards">
                  {previousMoves.map((item) => (
                    <a href={base + "node/" + item.node.id + "/"}>
                      <span>{item.label}</span>
                      <strong>{item.node.title}</strong>
                    </a>
                  ))}
                </div>
              </div>
            )}
            {nextMoves.length > 0 && (
              <div>
                <p class="eyebrow">Continue from here</p>
                <div class="move-cards">
                  {nextMoves.map((item) => (
                    <a href={base + "node/" + item.node.id + "/"}>
                      <span>{item.label}</span>
                      <strong>{item.node.title}</strong>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </section>
        )}

        {(previousMoves.length > 0 || nextMoves.length > 0) && (
          <section class="position-section" aria-labelledby="position-heading">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Debate line</p>
                <h2 id="position-heading">Where this sits in the debate</h2>
              </div>
              <p>
                This view follows conversational order rather than semantic arrow direction.
                Tap a move to continue that branch.
              </p>
            </div>
            <DebatePosition client:load graph={graph} currentId={node.id} basePath={base} />
          </section>
        )}

        {scriptureReferences.length > 0 && (
          <section class="scripture-section">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Scripture</p>
                <h2>Biblical references</h2>
              </div>
              <p>WEB text is stored locally for research context; ESV links open on YouVersion.</p>
            </div>
            <div class="scripture-grid">
              {scriptureReferences.map((entry) => entry && (
                <article class="scripture-card">
                  <div class="scripture-card-head">
                    <strong>{entry.lookup.canonical}</strong>
                    <span>WEB</span>
                  </div>
                  <div class="scripture-verses">
                    {entry.lookup.verses.slice(0, 12).map((verse) => (
                      <p><sup>{verse.verse}</sup> {verse.text}</p>
                    ))}
                    {entry.lookup.verses.length > 12 && (
                      <p class="scripture-truncated">Showing the first 12 verses of this passage.</p>
                    )}
                  </div>
                  {entry.note && <p class="scripture-note">{entry.note}</p>}
                  <a class="external-source" href={entry.lookup.youVersionEsvUrl} target="_blank" rel="noreferrer">
                    Read ESV on YouVersion ↗
                  </a>
                </article>
              ))}
            </div>
          </section>
        )}

        {(references.length > 0 || evidenceNodes.length > 0) && (
          <section class="evidence-section">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Evidence & sources</p>
                <h2>What this node is built on</h2>
              </div>
            </div>

            {evidenceNodes.length > 0 && (
              <div class="evidence-grid">
                {evidenceNodes.map((item) => (
                  <a class="evidence-card" href={base + "node/" + item.node.id + "/"}>
                    <span class="type-badge type-evidence">evidence</span>
                    <strong>{item.node.title}</strong>
                    {item.node.summary && <p>{item.node.summary}</p>}
                  </a>
                ))}
              </div>
            )}

            {references.length > 0 && (
              <div class="source-grid">
                {references.map((reference) => {
                  const source = reference.node!;
                  return (
                    <article class="source-card">
                      <div class="source-card-head">
                        <span class="source-class">{sourceClass(source)}</span>
                        {source.source?.kind && <span>{source.source.kind}</span>}
                      </div>
                      <h3><a href={base + "node/" + source.id + "/"}>{source.title}</a></h3>
                      <p class="source-meta">
                        {source.source?.authors?.join(", ")}
                        {source.source?.year && " · " + source.source.year}
                        {source.source?.publisher && " · " + source.source.publisher}
                      </p>
                      {reference.locator && <p><strong>Locator:</strong> {reference.locator}</p>}
                      {reference.note && <p>{reference.note}</p>}
                      <div class="source-actions">
                        <a href={base + "node/" + source.id + "/"}>Reference page</a>
                        {source.source?.url && (
                          <a href={source.source.url} target="_blank" rel="noreferrer">Original ↗</a>
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>
            )}
          </section>
        )}
      </div>

      <aside class="relationship-panel">
        {topicNodes.length > 0 && (
          <section>
            <h2>Topics</h2>
            <div class="link-stack">
              {topicNodes.map((topic) => topic && (
                <a href={base + "topic/" + topic.id + "/"}>
                  <strong>{topic.title}</strong>
                </a>
              ))}
            </div>
          </section>
        )}

        {semanticOutgoing.length > 0 && (
          <section>
            <h2>Semantic relationships</h2>
            <div class="link-stack">
              {semanticOutgoing.map((item) => (
                <a href={base + "node/" + item.node.id + "/"}>
                  <span>{item.type.replaceAll("_", " ")}</span>
                  <strong>{item.node.title}</strong>
                </a>
              ))}
            </div>
          </section>
        )}

        {semanticIncoming.length > 0 && (
          <section>
            <h2>Referenced by</h2>
            <div class="link-stack">
              {semanticIncoming.slice(0, 12).map((item) => (
                <a href={base + "node/" + item.node.id + "/"}>
                  <span>{item.type.replaceAll("_", " ")} from</span>
                  <strong>{item.node.title}</strong>
                </a>
              ))}
            </div>
          </section>
        )}

        {node.tags.length > 0 && (
          <section>
            <h2>Tags</h2>
            <div class="tag-row">
              {node.tags.map((tag) => <span>#{tag}</span>)}
            </div>
          </section>
        )}
      </aside>
    </div>

    <dialog
      class="node-feedback-dialog"
      data-node-feedback-dialog
      data-node-id={node.id}
      data-node-title={node.title}
      data-node-type={node.type}
      data-node-file={node.file}
      data-feedback-endpoint={feedbackApiEndpoint}
      data-node-topics={JSON.stringify(topicNodes.map((topic) => topic && ({ id: topic.id, title: topic.title })).filter(Boolean))}
      data-previous-moves={JSON.stringify(previousMoves.map((item) => ({ id: item.node.id, title: item.node.title, label: item.label })))}
      data-next-moves={JSON.stringify(nextMoves.map((item) => ({ id: item.node.id, title: item.node.title, label: item.label })))}
    >
      <div class="node-feedback-shell">
        <div class="node-feedback-head">
          <div>
            <p class="eyebrow">Continue the argument</p>
            <h2>Respond to this node</h2>
          </div>
          <button type="button" class="node-feedback-close" data-close-node-feedback aria-label="Close feedback form">×</button>
        </div>

        <p class="node-feedback-intro">
          Ask a question, challenge a point, add a response, or flag missing evidence.
          The node and nearby debate context will be attached automatically.
        </p>

        <form class="node-feedback-form" data-node-feedback-form>
          <label>
            <span>What kind of contribution is this?</span>
            <select name="kind">
              <option value="Question">Question</option>
              <option value="Response">Response</option>
              <option value="Objection">Objection</option>
              <option value="Missing evidence">Missing evidence</option>
              <option value="Correction">Correction</option>
              <option value="Other">Other</option>
            </select>
          </label>

          <label>
            <span>Name <small>(optional)</small></span>
            <input
              name="submitterName"
              type="text"
              maxlength="80"
              autocomplete="name"
              placeholder="Anonymous if left blank"
            />
          </label>

          <label>
            <span>Your response</span>
            <textarea
              name="feedback"
              rows="7"
              maxlength="4000"
              required
              placeholder="What would you ask, challenge, add, or want explained here?"
            ></textarea>
          </label>

          {directFeedbackEnabled && (
            <div class="node-feedback-turnstile">
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-action="node-feedback"
                data-theme="auto"
              ></div>
            </div>
          )}

          <div class="node-feedback-context">
            <strong>Attached context</strong>
            <span>{node.type} · {node.id}</span>
            {topicNodes[0] && <span>Topic: {topicNodes[0]!.title}</span>}
          </div>

          <div class="node-feedback-actions">
            <button type="button" data-close-node-feedback>Cancel</button>
            <button type="submit" class="node-feedback-submit">
              {directFeedbackEnabled ? "Submit response" : "Continue to GitHub →"}
            </button>
          </div>
          <p class="node-feedback-note" data-node-feedback-status aria-live="polite">
            {directFeedbackEnabled
              ? "This creates a public GitHub issue through Apologetics Map Bot. Your name is optional."
              : "GitHub will open with a prefilled issue. Review it there, then submit it to the repository."}
          </p>
        </form>

        <section class="node-feedback-success" data-node-feedback-success hidden aria-live="polite">
          <div class="node-feedback-success-icon" aria-hidden="true">✓</div>
          <p class="eyebrow">Submission complete</p>
          <h2>Thanks for contributing</h2>
          <p>
            Your submission was received and will be processed shortly.
            Check back on this node later to see any updates that come from it.
          </p>
          <div class="node-feedback-success-actions">
            <a href="#" data-node-feedback-issue-link hidden>View submitted issue ↗</a>
            <button type="button" data-close-node-feedback>Close</button>
          </div>
        </section>
      </div>
    </dialog>
  </article>

  {directFeedbackEnabled && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-copy-current-link]").forEach((button) => {
      button.addEventListener("click", async () => {
        const canonicalUrl = window.location.origin + window.location.pathname;
        try {
          await navigator.clipboard.writeText(canonicalUrl);
          const original = button.textContent;
          button.textContent = "Copied";
          window.setTimeout(() => { button.textContent = original; }, 1600);
        } catch {
          button.textContent = "Copy failed";
          window.setTimeout(() => { button.textContent = "Copy direct link"; }, 1600);
        }
      });
    });

    const feedbackDialog = document.querySelector<HTMLDialogElement>("[data-node-feedback-dialog]");
    const feedbackForm = feedbackDialog?.querySelector<HTMLFormElement>("[data-node-feedback-form]");
    const feedbackSuccess = feedbackDialog?.querySelector<HTMLElement>("[data-node-feedback-success]");
    const feedbackIntro = feedbackDialog?.querySelector<HTMLElement>(".node-feedback-intro");
    const feedbackIssueLink = feedbackDialog?.querySelector<HTMLAnchorElement>("[data-node-feedback-issue-link]");

    function resetFeedbackDialog() {
      feedbackForm?.reset();
      if (feedbackForm) feedbackForm.hidden = false;
      if (feedbackSuccess) feedbackSuccess.hidden = true;
      if (feedbackIntro) feedbackIntro.hidden = false;
      if (feedbackIssueLink) {
        feedbackIssueLink.hidden = true;
        feedbackIssueLink.removeAttribute("href");
      }
      showFeedbackStatus(
        feedbackDialog?.dataset.feedbackEndpoint
          ? "This creates a public GitHub issue through Apologetics Map Bot. Your name is optional."
          : "GitHub will open with a prefilled issue. Review it there, then submit it to the repository.",
      );
      (window as any).turnstile?.reset();
    }

    document.querySelectorAll<HTMLButtonElement>("[data-open-node-feedback]").forEach((button) => {
      button.addEventListener("click", () => {
        resetFeedbackDialog();
        feedbackDialog?.showModal();
      });
    });

    feedbackDialog?.querySelectorAll<HTMLButtonElement>("[data-close-node-feedback]").forEach((button) => {
      button.addEventListener("click", () => feedbackDialog.close());
    });

    feedbackDialog?.addEventListener("click", (event) => {
      if (event.target === feedbackDialog) feedbackDialog.close();
    });

    function buildFallbackIssueUrl(payload: {
      kind: string;
      feedback: string;
      submitterName: string;
      node: {
        id: string;
        title: string;
        type: string;
        file: string;
        pageUrl: string;
        topics: Array<{ id: string; title: string }>;
        previousMoves: Array<{ id: string; title: string; label: string }>;
        nextMoves: Array<{ id: string; title: string; label: string }>;
      };
    }) {
      const formatMoves = (moves: Array<{ id: string; title: string; label: string }>) =>
        moves.length
          ? moves.map((move) => `- ${move.label}: ${move.title} (\`${move.id}\`)`).join("\n")
          : "- None";

      const topicLines = payload.node.topics.length
        ? payload.node.topics.map((topic) => `- ${topic.title} (\`${topic.id}\`)`).join("\n")
        : "- None";

      const issueTitle = `[Node feedback] ${payload.kind}: ${payload.node.title}`;
      const issueBody = [
        "## Contribution",
        `**Kind:** ${payload.kind}`,
        `**Submitted by:** ${payload.submitterName || "Anonymous"}`,
        "",
        payload.feedback,
        "",
        "## Node context",
        `- **Node:** ${payload.node.title} (\`${payload.node.id}\`)`,
        `- **Type:** ${payload.node.type}`,
        `- **Page:** ${payload.node.pageUrl}`,
        `- **Content file:** \`${payload.node.file}\``,
        "",
        "### Topic",
        topicLines,
        "",
        "### Previous debate moves",
        formatMoves(payload.node.previousMoves),
        "",
        "### Possible next moves",
        formatMoves(payload.node.nextMoves),
        "",
        "<!-- node-feedback:v1 -->",
      ].join("\n");

      const issueUrl = new URL("https://github.com/drecg96-org/apologetics-map/issues/new");
      issueUrl.searchParams.set("title", issueTitle);
      issueUrl.searchParams.set("body", issueBody);
      return issueUrl.toString();
    }

    function showFeedbackStatus(message: string, linkUrl?: string, linkLabel = "View GitHub issue.") {
      const status = feedbackDialog?.querySelector<HTMLElement>("[data-node-feedback-status]");
      if (!status) return;
      status.replaceChildren(document.createTextNode(message));
      if (linkUrl) {
        status.append(document.createTextNode(" "));
        const link = document.createElement("a");
        link.href = linkUrl;
        link.textContent = linkLabel;
        status.append(link);
      }
    }

    feedbackForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!feedbackDialog || !feedbackForm) return;

      const formData = new FormData(feedbackForm);
      const kind = String(formData.get("kind") || "Feedback");
      const feedback = String(formData.get("feedback") || "").trim();
      const submitterName = String(formData.get("submitterName") || "").trim();
      if (!feedback) return;

      const payload = {
        kind,
        feedback,
        submitterName,
        node: {
          id: feedbackDialog.dataset.nodeId || "",
          title: feedbackDialog.dataset.nodeTitle || "",
          type: feedbackDialog.dataset.nodeType || "",
          file: feedbackDialog.dataset.nodeFile || "",
          pageUrl: window.location.origin + window.location.pathname,
          topics: JSON.parse(feedbackDialog.dataset.nodeTopics || "[]") as Array<{ id: string; title: string }>,
          previousMoves: JSON.parse(feedbackDialog.dataset.previousMoves || "[]") as Array<{ id: string; title: string; label: string }>,
          nextMoves: JSON.parse(feedbackDialog.dataset.nextMoves || "[]") as Array<{ id: string; title: string; label: string }>,
        },
      };

      const fallbackUrl = buildFallbackIssueUrl(payload);
      const endpoint = feedbackDialog.dataset.feedbackEndpoint || "";

      if (!endpoint) {
        window.location.href = fallbackUrl;
        return;
      }

      const turnstileToken = String(formData.get("cf-turnstile-response") || "");
      if (!turnstileToken) {
        showFeedbackStatus("Complete the verification before submitting.");
        return;
      }

      const submitButton = feedbackForm.querySelector<HTMLButtonElement>(".node-feedback-submit");
      if (submitButton) submitButton.disabled = true;
      showFeedbackStatus("Submitting…");

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ ...payload, turnstileToken }),
        });
        const result = await response.json() as { ok?: boolean; issueUrl?: string; error?: string };

        if (!response.ok || !result.ok) {
          throw new Error(result.error || "Submission failed");
        }

        feedbackForm.reset();
        (window as any).turnstile?.reset();
        feedbackForm.hidden = true;
        if (feedbackIntro) feedbackIntro.hidden = true;
        if (feedbackSuccess) feedbackSuccess.hidden = false;
        if (feedbackIssueLink && result.issueUrl) {
          feedbackIssueLink.href = result.issueUrl;
          feedbackIssueLink.hidden = false;
        }
      } catch {
        (window as any).turnstile?.reset();
        showFeedbackStatus(
          "Direct submission is unavailable right now.",
          fallbackUrl,
          "Open a prefilled GitHub issue instead.",
        );
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  </script>
</BaseLayout>
